{
  "name": "pressit",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pressit/api --filter @pressit/web dev",
    "build": "pnpm --filter @pressit/web build && pnpm --filter @pressit/api build",
    "start": "pnpm --filter @pressit/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "mcp:on": "node scripts/mcp.mjs on",
    "mcp:off": "node scripts/mcp.mjs off",
    "mcp:status": "node scripts/mcp.mjs status",
    "mcp:version": "node scripts/version.mjs",
    "mcp:publish": "pnpm --filter pressit-mcp test && pnpm --filter pressit-mcp publish"
  }
}
